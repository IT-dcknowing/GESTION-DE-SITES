# Le scraper des achats FNE — copier en .env (ignoré par git).
# GESTION-DE-SITES : un seul compte, celui de l'entreprise (son NCC). Rien d'autre n'est relevé :
# les factures et avoirs REÇUS, émis à ce NCC par des tiers.

# La page de connexion du portail (celle qui se termine par /fr/login). Requis.
#
# - ESSAI (16/10 : on commence par lui) : http://54.247.95.108/fr/login
#   C'est l'environnement de test de la DGI — son API est http://54.247.95.108/ws, que le scraper
#   déduit tout seul de cette adresse. Il ne porte PAS les pièces réelles de l'entreprise : il sert à
#   vérifier que la connexion et la lecture marchent. Les accès d'essai peuvent différer des vrais.
# - PRODUCTION (plus tard) : l'adresse que vous ouvrez dans votre navigateur avec vos vrais accès,
#   terminée par /fr/login. Changer cette seule ligne suffit.
FNE_URL=http://54.247.95.108/fr/login

# Le compte de l'entreprise : le NCC, et le mot de passe du portail. (Ou les mettre dans
# identifiants.json — voir identifiants.exemple.json.) Ce fichier n'est jamais versionné.
LOGIN=
PASSWORD=

# "false" pour voir le navigateur travailler (débogage). Tout le reste = sans fenêtre.
FNE_HEADLESS=true

# Début du relevé COMPLET (le premier, et celui de 02 h 30). Les relevés de la journée, eux, ne
# reprennent que les 35 derniers jours (FNE_DEPUIS_JOURS dans le .env de l'application).
ACHATS_DEPUIS=2023-01-01

# Dossier de dépôt : laisser vide. C'est storage/app/portail-fne de l'application, où
# `php artisan fne:releve-achats` et l'écran Fournisseurs › Factures FNE vont lire.
UPLOAD_PATH_FOLDER=

# Les bibliothèques dont Chromium a besoin, quand l'hébergement ne les a pas (« error while loading
# shared libraries »). Rempli par `bash bibliotheques-chromium.sh`, qui affiche la ligne à copier ici.
# Vide sur un poste ou un serveur où Chromium démarre seul.
FNE_LIBS=
