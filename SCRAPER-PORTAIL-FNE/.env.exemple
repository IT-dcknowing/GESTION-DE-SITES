# Le scraper du portail FNE — copier en .env (ignoré par git).
#
# Repris de Selflow le 12/10 pour GESTION-DE-SITES. Ce fichier a le dernier mot sur
# le .env de l'application : ce qui n'est pas défini ici est repris de la racine.

# Page de connexion du portail de la DGI. Requis.
FNE_URL=http://54.247.95.108/fr/login

# "false" pour voir le navigateur travailler (débogage). Tout le reste = headless.
FNE_HEADLESS=true

# Dossier de dépôt. À laisser vide dans le cas normal : storage/app/portail-fne
# de l'application, où `php artisan fne:releve-achats` va lire. Ne remplir que pour
# forcer un autre emplacement.
UPLOAD_PATH_FOLDER=

# Envoi HTTP en plus du dépôt, pour un scraper qui ne tourne pas sur le poste
# de l'application. Laisser vide : GESTION-DE-SITES n'expose aucune route d'upload.
# Le fichier se dépose à l'écran Fournisseurs › Factures FNE, ou se range par la commande.
URL_SERVER=
SERVER_UPLOAD_TOKEN=
SERVER_UPLOAD_FIELD=file

# Chemin de php. Mettre le chemin ABSOLU, en barres obliques : le scraper est
# lancé par le planificateur de Windows, dont l'environnement n'a pas le PATH
# d'un terminal ouvert à la main. « php » tout court marche à l'essai et échoue
# une fois planifié — le pire des deux mondes.
# Exemple : C:/php-8.3.29-Win32-vs16-x64/php.exe
PHP_BINAIRE=php

# Repli mono-entreprise : si le poste ne relève qu'un seul portail, ces deux
# variables évitent d'avoir à tenir identifiants.json. Le login est le NCC de
# l'entreprise — c'est par lui que la commande retrouve l'entreprise.
LOGIN=
PASSWORD=
