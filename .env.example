APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Connexion Google (OAuth) — voir Google Cloud Console > Identifiants.
# GOOGLE_REDIRECT_URI doit correspondre exactement à un URI de redirection autorisé
# déclaré côté Google (schéma + hôte + port + chemin identiques), ex. https://votre-domaine/auth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Notifications poussées (Web Push). Générer une seule fois avec « php artisan push:cles »
# puis recopier ici. Les remplacer désabonne tous les appareils déjà enregistrés.
# Si ces valeurs restent vides, l'application fonctionne normalement : seules les
# notifications hors navigation sont désactivées.
VAPID_CLE_PUBLIQUE=
VAPID_CLE_PRIVEE=
VAPID_CONTACT=mailto:contact@dc-knowing.com

# Hébergement mutualisé : le certificat HTTPS est porté par un serveur frontal qui
# transmet la requête en clair. Sans cette confiance, Laravel se croit en http et
# fabrique des redirections qui bouclent. « * » convient sur un mutualisé, où l'on
# ne connaît pas l'adresse du frontal.
PROXYS_DE_CONFIANCE=*

# ============================================================================
# ACCÈS À UN ENVIRONNEMENT DE TEST
# ============================================================================
# À renseigner uniquement sur un serveur de développement atteignable depuis
# Internet : il travaille sur une copie de la production et porte donc de vraies
# données clients. Sans effet en production et depuis le réseau local.
# Laissées vides sur un serveur public hors production, elles ferment l'accès.
ACCES_TEST_UTILISATEUR=
ACCES_TEST_MOT_DE_PASSE=
